# GEMINI_API_KEY: Optional for Gemini AI features (e.g. prompt director)
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted
APP_URL="MY_APP_URL"

# HF_TOKEN: Hugging Face User Access Token (e.g. hf_...)
# Set this in your Render Dashboard -> Environment Variables to prevent automated scanner revocation!
HF_TOKEN=""

# PORT: Server port (defaults to 3000 in dev, 10000 on Render)
PORT=3000
